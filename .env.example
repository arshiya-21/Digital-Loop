# Digital Loop — environment.
#
# Copy to backend/.env for a local run. Most values below are the default, so a
# near-empty file works; these are here to say what exists and what it means.
# The three with no default — DL_DB_USER, DL_DB_PASSWORD and SANDMAN_SECRET —
# have to be set or the server refuses to start.

# ---------------------------------------------------------------- backend ---

# One port serves everything, under one path: the studio and the API both live
# below DL_BASE_PATH. This is the only address SandMan needs.
PORT=5000

# Where this service sits inside the URL. Set it to '/' to serve from the root
# of its own host. Everything moves with it: the page's <base href>, the API,
# and the session cookie's Path.
DL_BASE_PATH=/sandman/digitalloop

# The startup banner prints one line: the address. Set this to see which
# database, which SandMan and which addresses may mint a launch.
# DL_VERBOSE=1

# Origin allowed to call the API from a browser.
#
# Normally unused: this server serves the studio too, so the browser is already
# same-origin. It matters only if you run the studio from somewhere else — the
# Vite dev server on :8000, say, for hot reload.
CORS_ORIGIN=http://localhost:8000

# ⚠ 'stub' means a launch is trusted because it carried the shared secret,
# which is a placeholder rather than a signature. The server REFUSES TO START
# on any other value until real verification is implemented — see
# backend/src/middleware/auth.js.
AUTH_MODE=stub

# A redeemed launch lasts this long before you go back through SandMan.
SESSION_HOURS=12

# Seals the passwords and SSH keys of databases added in the studio.
#
# Needed only by the "add a database" feature — nothing else here keeps a
# secret at rest. Deliberately has NO DEFAULT: a key that ships with the code
# protects nothing, so without this the API refuses to store a password rather
# than writing it in plain text.
#
# Generate one, keep it out of version control, and keep it somewhere other
# than beside the database file it protects:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Losing it means every stored database password has to be entered again.
# There is no recovery, by design.
DL_SECRET_KEY=

# --------------------------------------------------------------- database ---

# MySQL 8. This holds every design in the plant and all of its history.
#
# Host, port and name have defaults because they are not secrets and the
# defaults are right for a local server. The account does not: an account that
# ships in the source is an account anybody can use, so the server refuses to
# start without DL_DB_USER.
#
# The database is created on first start if it is missing, and the schema in
# database/schema.sql is applied every time — so the account needs CREATE as
# well as the usual read and write. A deployment that would rather not grant
# that can create the database by hand and give the account rights on it alone.
DL_DB_HOST=127.0.0.1
DL_DB_PORT=3306
DL_DB_NAME=digital_loop
DL_DB_USER=
DL_DB_PASSWORD=

# ---------------------------------------------------------------- SandMan ---

# Where SandMan is — its context path, and nothing deeper. One address: the
# two things this service needs from SandMan hang off it.
#
#   liveness  ${SANDMAN_URL}/api/su/digital-loop/health
#   "Back"    ${SANDMAN_URL}/user/dashboard
#
# SandMan itself sends a caller who is no longer signed in on to /home, so
# "Back" lands somewhere sensible either way without this service having to
# know whether the session is still good.
#
# The API checks liveness before it will honour a launch, so the studio is only
# openable while SandMan is actually running.
SANDMAN_URL=http://localhost:8080/sandman

# Shared server-to-server, so a browser cannot mint its own launch. Must match
# SandMan's DIGITAL_LOOP_SECRET exactly.
#
# ⚠ NO DEFAULT, and the server refuses to start without it. A shared secret
# with a fallback is not a secret: it ships in the source, so anybody who can
# reach port 5000 could mint a launch for any foundry and any role.
#
# At least 32 characters; 64 hex is the intended form. Never commit it, never
# print it, never put it in a properties file:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANDMAN_SECRET=<set-a-64-char-random-value>

# Which addresses may mint a launch.
#
# Port 5000 serves the studio as well, so it cannot be firewalled — the browser
# has to reach it. The launch endpoint is restricted instead. Loopback by
# default, because SandMan runs on this machine; set it to SandMan's server
# address if it does not, and keep /api/v1/session/launch off any public proxy.
LAUNCH_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# The session cookie.
#
# The token lives here and nowhere else — never a URL, never a response body,
# never anything script can read. Lax is right while SandMan and the studio
# share a registrable domain (ports are not part of "site", so localhost:8080
# and localhost:5000 are the same site). Different domains in production need
# SameSite=None, which browsers only honour with Secure, which means HTTPS.
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false

# How long a launch ticket may sit unredeemed, in seconds.
SANDMAN_TICKET_SECONDS=120

# ------------------------------------------------------------------- seed ---

# Which foundry and line the demo loop is filed under. These are SandMan's own
# identifiers: they must match what SandMan sends in its launch, or the seeded
# loop belongs to a line nobody arrives on.
#
# Real SandMan sends the customer and foundry_line primary keys — Munjal Kiriu
# is customer 52, with lines 1 (Disa 230C) and 2 (Disa 231Y).
SEED_FOUNDRY_ID=FND-MUNJAL-KIRU
SEED_FOUNDRY_NAME=Munjal Kiru
SEED_LINE_ID=LINE-1
SEED_LINE_NAME=Line 1
